    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/Workload</IRI>
        <Literal>Represents an application or a component of an application running on the infrastructure.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/WorkloadController</IRI>
        <Literal>An abstract entity that manages the deployment and scaling of execution units (e.g., K8s Deployment).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/StatelessWorkloadController</IRI>
        <Literal>A controller for workloads that do not maintain persistent state across restarts (e.g., K8s ReplicaSet).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/StatefulWorkloadController</IRI>
        <Literal>A controller for workloads that require stable persistence and unique identifiers (e.g., K8s StatefulSet).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/Service</IRI>
        <Literal>An abstract way to expose an application running on a set of execution units as a network service (e.g., K8s Service).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/ExecutionUnit</IRI>
        <Literal>The smallest deployable unit of computing. Maps to a Kubernetes Pod, Docker Swarm Task, or Nomad Allocation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/ConfigurationResource</IRI>
        <Literal>A generic resource for storing configuration data (e.g., K8s ConfigMap).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/LivenessCheck</IRI>
        <Literal>A health check to determine if an execution unit is still running correctly (e.g., K8s LivenessProbe).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/ReadinessCheck</IRI>
        <Literal>A health check to determine if an execution unit is ready to receive traffic (e.g., K8s ReadinessProbe).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/StartupCheck</IRI>
        <Literal>A health check to determine if an execution unit has successfully started (e.g., K8s StartupProbe).</Literal>
    </AnnotationAssertion>

</Ontology>


