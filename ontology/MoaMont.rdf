        <owl:disjointWith rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#VerticalScalingAction"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#LayerBoundary -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#LayerBoundary">
        <rdfs:comment>his categorizes the architectural tier at which the action operates (InfrastructureLayer, ContainerizationLayer, or ApplicationLayer)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#LifecycleControlAction -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#LifecycleControlAction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#FunctionalIntent"/>
        <rdfs:comment>Operations altering the execution state of a resource without changing its configuration or scale</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#MetricBasedCondition -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#MetricBasedCondition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCondition"/>
        <rdfs:comment>Evaluates quantitative observability telemetry against defined thresholds (e.g., asserting network latency drops below a defined limit).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#MigrateAction -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#MigrateAction">
