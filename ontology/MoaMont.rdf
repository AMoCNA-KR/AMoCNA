<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont/"
     xml:base="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont">
        <rdfs:comment>Ontology about knowledge representation of actions used in Cloud Native Execution Enviroment by autonomic computing components</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#dependsOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#dependsOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:comment>Establishes a strict chronological prerequisite, mathematically locking an action until fulfilled.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasCompensation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasCompensation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:comment>Explicitly links an action to its exact inverse operation, providing a Saga backward recovery path.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasCondition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasCondition">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCondition"/>
        <rdfs:comment>Umbrella property linking evaluation rules. Sub-properties include hasPreCondition (prerequisites) and hasPostCondition (success validation)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasCurrentState -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasCurrentState">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ComplexWorkflow"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionState"/>
        <rdfs:comment>Tracks the live progress of a workflow within the Petri Net abstraction.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionCost -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionCost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCost"/>
        <rdfs:comment>Maps the action to a specific disruption classification</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasFunctionalIntent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasFunctionalIntent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#FunctionalIntent"/>
        <rdfs:comment>Strictly categorizes an action under a single operational goal</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasLayerBoundary -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasLayerBoundary">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#LayerBoundary"/>
        <rdfs:comment>Confines an action to a singular architectural tier, preventing unintended cross-layer interference</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasPostCondition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasPostCondition">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasCondition"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCondition"/>
        <owl:propertyDisjointWith rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasPreCondition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasPreCondition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasPreCondition">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasCondition"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCondition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#isDecomposedInto -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#isDecomposedInto">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ComplexWorkflow"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:comment>Links a complex workflow to its constituent action primitives.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#targetsEntity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#targetsEntity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#TargetResource"/>
        <rdfs:comment>Acts as the semantic bridge connecting the action to an external structural node</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#costValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#costValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCost"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>A normalized numerical representation of predicted systemic disruption</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasActionID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasActionID">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A unique identifier (e.g., UUID) crucial for tracking stateful sagas.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasAuthMechanism -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasAuthMechanism">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#SimpleAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Specifies the required authentication method (e.g., BearerToken, BasicAuth) to be injected by the engine.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionDelay -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionDelay">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Specifies an intentional pause (in seconds) before the action is physically dispatched for execution.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionInstruction -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionInstruction">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#SimpleAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The physical command template (e.g. URL or bash script) to be hydrated at runtime.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionPayload -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionPayload">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#SimpleAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>(Optional) The request body payload template utilized for state-mutating operations.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionProtocol -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionProtocol">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#SimpleAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Specifies the protocol (e.g., REST, SHELL, gRPC) utilized by the stateless executor</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionStatus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionStatus">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Represents the explicit terminal or transitional outcome of an action (e.g., PENDING, COMPLETED, FAILED\_HTTP).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExpectedStatusCode -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExpectedStatusCode">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#SimpleAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>The strictly expected response code used by the executor to determine deterministic, synchronous success.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasHttpMethod -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasHttpMethod">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#SimpleAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>(Optional) The HTTP method (e.g., GET, POST) required if the protocol is REST</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasIdempotencyKey -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasIdempotencyKey">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A deterministic business hash utilized by the reasoner to aggressively deduplicate redundant alerts in the same time window</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasLastTransitionTimestamp -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasLastTransitionTimestamp">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Records the time of the last state change to detect and mitigate stalled workflows</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasPriority -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasPriority">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Defines the execution urgency, enabling the reasoning engine to sequence actions in the message broker</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#idempotencyWindowSeconds -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#idempotencyWindowSeconds">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Defines the explicit time window (in seconds) during which identical alerts are deduplicated, preventing autonomic thrashing</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#isIdempotent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#isIdempotent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#SimpleAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>A structural flag affirming the safety of blind retries (always true for simple actions).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#maxRetries -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#maxRetries">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#SimpleAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>The strictly defined limit of idempotent retry attempts following a transient failure.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#policyQueryString -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#policyQueryString">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The declarative code (e.g., a Rego snippet) evaluated against the cluster state for a given condition.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#timeoutSeconds -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#timeoutSeconds">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>The maximum permissible duration before the manager declares a divergence.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#targetsEntity"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#TargetResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasPreCondition"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionCost"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCost"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasLayerBoundary"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#LayerBoundary"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasActionID"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#timeoutSeconds"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionDelay"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasExecutionStatus"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasIdempotencyKey"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasLastTransitionTimestamp"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasPriority"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#idempotencyWindowSeconds"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#CircuitBreakAction -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#CircuitBreakAction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#TrafficRoutingAction"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ComplexWorkflow -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ComplexWorkflow">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#isDecomposedInto"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#AutonomicAction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#hasCurrentState"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#SimpleAction"/>
        <rdfs:comment>Stateful semantic containers that orchestrate SimpleAction instances via hierarchical task network and manage Saga-based compensations</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ConfigurationAction -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ConfigurationAction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#FunctionalIntent"/>
        <rdfs:comment>Actions mutating the declarative state, environment variables, or configuration maps of a target entity</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#EvacuateAction -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#EvacuateAction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#MobilityAction"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#MigrateAction"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCondition -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCondition">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#policyQueryString"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCost -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionCost">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#costValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>This categorizes the expected systemic disruption or temporal latency of an action</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionState -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#ExecutionState"/>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#FunctionalIntent -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#FunctionalIntent"/>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#HorizontalScalingAction -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#HorizontalScalingAction">
