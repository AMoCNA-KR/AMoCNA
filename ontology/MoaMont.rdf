    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#MobilityAction -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#MobilityAction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#FunctionalIntent"/>
        <rdfs:comment>Operations focused on the spatial distribution of workloads across the infrastructure</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#PatchAction -->

    <owl:Class rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#PatchAction">
