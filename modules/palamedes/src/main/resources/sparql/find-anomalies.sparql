SELECT DISTINCT ?resource ?resourceName ?intent
WHERE {
  # 1. Find resource and its current state
  ?resource cnee:hasCurrentState ?state .
  ?state a ?anomalyType .
  ?resource cnee:resourceName ?resourceName .
  
  # 2. Map anomaly type to remediation intent via BridgeOnt
  # This follows the 'isResolvedByIntent' restriction in BridgeOnt
  ?anomalyType rdfs:subClassOf ?restriction .
  ?restriction a owl:Restriction .
  ?restriction owl:onProperty bridge:isResolvedByIntent .
  ?restriction owl:someValuesFrom ?intent .
  
  # 3. Filter out resources that already have an active action
  FILTER NOT EXISTS {
    ?action moam:targetsEntity ?resource .
    ?action moam:hasCurrentState ?currentState .
    # Filter for active states (tokens in the Petri Net)
    FILTER(?currentState IN (moam:State_Initial, moam:State_Planned, moam:State_Validated, moam:State_InProgress, moam:State_Compensating))
  }
}
