SELECT DISTINCT ?resource ?resourceName ?intent
WHERE {
  # 1. Find resource and its current state
  ?resource ${PREFIX::RESOURCES_PREFIX}:hasState ?state .
  ?state a ?anomalyType .
  ?resource ${PREFIX::RESOURCES_PREFIX}:resourceName ?resourceName .
  
  # 2. Map anomaly type to remediation intent via ${PREFIX::BRIDGE_PREFIX}Ont
  # This follows the 'isResolvedByIntent' restriction in ${PREFIX::BRIDGE_PREFIX}Ont
  ?anomalyType rdfs:subClassOf ?restriction .
  ?restriction a owl:Restriction .
  ?restriction owl:onProperty ${PREFIX::BRIDGE_PREFIX}:isResolvedByIntent .
  ?restriction owl:someValuesFrom ?intent .
  
  # 3. Filter out resources that already have an active action
  FILTER NOT EXISTS {
    ?action ${PREFIX::ACTIONS_PREFIX}:targetsEntity ?resource .
    ?action ${PREFIX::ACTIONS_PREFIX}:hasCurrentState ?currentState .
    # Filter for active states
    FILTER(?currentState IN (${PREFIX::ACTIONS_PREFIX}:${INDIVIDUAL::STATE_INITIAL}, ${PREFIX::ACTIONS_PREFIX}:${INDIVIDUAL::STATE_PLANNED}, ${PREFIX::ACTIONS_PREFIX}:${INDIVIDUAL::STATE_VALIDATED}, ${PREFIX::ACTIONS_PREFIX}:${INDIVIDUAL::STATE_INPROGRESS}, ${PREFIX::ACTIONS_PREFIX}:${INDIVIDUAL::STATE_COMPENSATING}))
}
}
