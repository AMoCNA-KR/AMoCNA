SELECT DISTINCT ?action ?intent ?target ?protocol ?instruction ?method ?payload ?expectedStatusCode
       ?preId ?preType ?prePolicy 
       ?postId ?postType ?postPolicy 
       ?step ?compensation 
       ?functionalIntent ?layerBoundary ?costValue WHERE { 
  VALUES ?root { ${actionIri} }
  
  # 1. Discover all action nodes in the hierarchy.
  ?root (moam:isDecomposedInto|moam:hasCompensation|a/(moam:isDecomposedInto|moam:hasCompensation))* ?action .
  
  # 2. Identify all types (intents) for each node.
  ?action a ?intent .
  
  # 3. Resolve properties with Blueprint Inheritance.
  OPTIONAL { ?action moam:targetsEntity ?target } . 
  
  # Action Classification
  OPTIONAL { ?action moam:hasFunctionalIntent ?f1 } .
  OPTIONAL { ?intent moam:hasFunctionalIntent ?f2 } .
  BIND(COALESCE(?f1, ?f2) AS ?functionalIntent) .

  OPTIONAL { ?action moam:hasLayerBoundary ?l1 } .
  OPTIONAL { ?intent moam:hasLayerBoundary ?l2 } .
  BIND(COALESCE(?l1, ?l2) AS ?layerBoundary) .

  OPTIONAL { 
    ?action moam:hasExecutionCost ?c1 .
    ?c1 moam:costValue ?v1 .
  } .
  OPTIONAL {
    ?intent moam:hasExecutionCost ?c2 .
    ?c2 moam:costValue ?v2 .
  } .
  BIND(COALESCE(?v1, ?v2) AS ?costValue) .

  # Protocol Details
  OPTIONAL { ?action moam:hasExecutionProtocol ?p1 } .
  OPTIONAL { ?intent moam:hasExecutionProtocol ?p2 } .
  BIND(COALESCE(?p1, ?p2) AS ?protocol) .

  OPTIONAL { ?action moam:hasExecutionInstruction ?i1 } .
  OPTIONAL { ?intent moam:hasExecutionInstruction ?i2 } .
  BIND(COALESCE(?i1, ?i2) AS ?instruction) .

  OPTIONAL { ?action moam:hasHttpMethod ?m1 } .
  OPTIONAL { ?intent moam:hasHttpMethod ?m2 } .
  BIND(COALESCE(?m1, ?m2) AS ?method) .

  OPTIONAL { ?action moam:hasExpectedStatusCode ?s1 } .
  OPTIONAL { ?intent moam:hasExpectedStatusCode ?s2 } .
  BIND(COALESCE(?s1, ?s2) AS ?expectedStatusCode) .

  # 4. Conditions
  OPTIONAL { 
    ?action moam:hasPreCondition ?preId . 
    ?preId a ?preType . 
    ?preId moam:policyQueryString ?prePolicy . 
  } . 
  OPTIONAL { 
    ?action moam:hasPostCondition ?postId . 
    ?postId a ?postType . 
    ?postId moam:policyQueryString ?postPolicy . 
  } . 
  
  # 5. Decomposition Links
  OPTIONAL { ?action moam:isDecomposedInto ?s1 } .
  OPTIONAL { ?intent moam:isDecomposedInto ?s2 } .
  BIND(COALESCE(?s1, ?s2) AS ?step) .
  
  OPTIONAL { ?step moam:hasCompensation ?compensation } . 
}
