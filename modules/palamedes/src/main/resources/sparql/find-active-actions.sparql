
SELECT DISTINCT ?action ?resource ?resourceName ?state
WHERE {
  ?action ${PREFIX::ACTIONS_PREFIX}:hasCurrentState ?stateIri .
  ?action ${PREFIX::ACTIONS_PREFIX}:targetsEntity ?resource .
  ?resource ${PREFIX::RESOURCES_PREFIX}:resourceName ?resourceName .
  
  # Filter for non-terminal states
  FILTER(?stateIri IN (${PREFIX::ACTIONS_PREFIX}:State_Initial, ${PREFIX::ACTIONS_PREFIX}:State_Planned, ${PREFIX::ACTIONS_PREFIX}:State_Validated, ${PREFIX::ACTIONS_PREFIX}:State_InProgress, ${PREFIX::ACTIONS_PREFIX}:State_Compensating))
  
  BIND(REPLACE(STR(?stateIri), "^.*#", "") AS ?state)
}
