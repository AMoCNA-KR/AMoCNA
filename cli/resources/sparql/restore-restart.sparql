PREFIX moam: <http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#>
DELETE DATA {
  moam:RestartPodIntent moam:hasExecutionInstruction "kubectl rollout restart deployment/${resourceName} FAIL_NOW" .
};
INSERT DATA {
  moam:RestartPodIntent moam:hasExecutionInstruction "kubectl rollout restart deployment/${resourceName}" .
}
