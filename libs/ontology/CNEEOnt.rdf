<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/"
     xml:base="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/assignedIP -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/assignedIP">
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/IPAddress"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/communicatesWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/communicatesWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/CloudNativeEntity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/contains -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/contains">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/isPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/dependsOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/dependsOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/dependsOnResource -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/dependsOnResource">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/CloudNativeEntity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/deploys -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/deploys"/>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/emitsTelemetry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/emitsTelemetry">
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/ObservabilityElement"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/exposesEndpoint -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/exposesEndpoint">
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Endpoint"/>
    </owl:ObjectProperty>
    



    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/hasState -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/hasState">
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/State"/>
        <rdfs:comment>Links a cloud native entity to one or more domain-specific states.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/hosts -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/hosts">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/isHostedOn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/isHostedOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/isHostedOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/isPartOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/isPartOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/isRealizedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/isRealizedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Microservice"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Workload"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/locatedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/locatedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/TopologyElement"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/monitoredByCheck -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/monitoredByCheck">
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/HealthCheckEndpoint"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/pullsImageFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/pullsImageFrom">
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/ImageRegistry"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/authenticatesWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/authenticatesWith">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/ExecutionUnit"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Secret"/>
        <rdfs:comment>Links an ExecutionUnit (or Workload) to a Secret it references in spec.imagePullSecrets.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/grantsAccessTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/grantsAccessTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Secret"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/ImageRegistry"/>
        <rdfs:comment>Links a Secret to the ImageRegistry it authenticates to. A Secret that grantsAccessTo a registry is a registry pull secret.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/usesImage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/usesImage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Container"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Image"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/usesStorage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/usesStorage">
        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/StorageResource"/>
    </owl:ObjectProperty>
    


