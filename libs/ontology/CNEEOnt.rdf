    <owl:Class rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/SecurityVulnerabilityDetectedState">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/State"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Anomaly"/>
        <rdfs:comment>Marker anomaly state indicating a known security vulnerability in the referenced Image (matched via cnee:resourceName and cnee:version). Remediation target versions and CVE identifiers belong in the vulnerability feed (e.g. demo-catalog.yaml), not in this ontology.</rdfs:comment>
    </owl:Class>

