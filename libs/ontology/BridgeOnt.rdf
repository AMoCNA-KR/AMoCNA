     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/BridgeOnt">
        <owl:imports rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont"/>
        <owl:imports rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt"/>
    </owl:Ontology>
    


