                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#PatchAction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
</rdf:RDF>



