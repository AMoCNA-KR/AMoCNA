    <!-- http://www.semanticweb.org/patryk/ontologies/2026/4/BridgeOnt#isResolvedByIntent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/patryk/ontologies/2026/4/BridgeOnt#isResolvedByIntent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/State"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#FunctionalIntent"/>
        <rdfs:comment>Semantic link mapping a degraded infrastructure state to an autonomic intent</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/CloudNativeEntity -->

    <rdf:Description rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/CloudNativeEntity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#TargetResource"/>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/ContainerDead -->

    <rdf:Description rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/ContainerDead">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/BridgeOnt#isResolvedByIntent"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#RestartAction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/ExecutionUnitFailed -->

    <rdf:Description rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/ExecutionUnitFailed">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/BridgeOnt#isResolvedByIntent"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/patryk/ontologies/2026/4/MoaMont#RestartAction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>

    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/NodeNotReadyState -->

    <rdf:Description rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/NodeNotReadyState">
        <rdfs:subClassOf>
            <owl:Restriction>
