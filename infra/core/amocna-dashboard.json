{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Sock Shop Frontend Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum{service='frontend'}[1m])) / sum(rate(http_request_duration_seconds_count{service='frontend'}[1m]))",
          "legendFormat": "Average Latency",
          "refId": "A"
        },
        {
          "expr": "0.85",
          "legendFormat": "SLA Threshold (Scenario 1)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Orders Service Latency (Persistent Check)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum{service='orders'}[1m])) / sum(rate(http_request_duration_seconds_count{service='orders'}[1m]))",
          "legendFormat": "Average Latency",
          "refId": "A"
        },
        {
          "expr": "0.23",
          "legendFormat": "SLA Threshold (Scenario 2)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "AMoCNA Component CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace='amocna', pod=~'palamedes.*'}[1m]))",
          "legendFormat": "Palamedes CPU",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace='amocna', pod=~'themis.*'}[1m]))",
          "legendFormat": "Themis CPU",
          "refId": "B"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace='amocna', pod=~'metrics-adapter.*'}[1m]))",
          "legendFormat": "Metrics Adapter CPU",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Petri Net Action Activity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "count(rabbitmq_queue_messages{queue='amocna.actions.queue'})",
          "legendFormat": "Pending Actions",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["amocna", "experiments"],
