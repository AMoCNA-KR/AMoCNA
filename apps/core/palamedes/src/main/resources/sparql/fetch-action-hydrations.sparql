${SPARQL_PREFIXES}
SELECT DISTINCT ?action ?payload WHERE {
  VALUES ?action { ${IRI::actionIds} }
  
  # Search up the decomposition hierarchy to allow SAGA steps to inherit hydration.
  # We use property path (isPartOf | ^isDecomposedInto) to follow both relational and decomposition links.
  ?parent (^${PREFIX::ACTIONS_PREFIX}:isDecomposedInto)* ?action .
  
  # Return the payload from the nearest parent (including self) that has one.
  ?parent ${PREFIX::ACTIONS_PREFIX}:hydrationPayload ?payload .
}
